{
  "name": "co-co",
  "private": true,
  "version": "0.1.0",
  "releaseChannel": "alpha",
  "description": "co-co (Coach Cockpit) – Desktop-App für J+S-Coaches auf Basis von eCamp v3",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w apps/desktop",
    "build": "npm run build -w apps/desktop",
    "typecheck": "npm run typecheck -w apps/desktop",
    "test": "npm run test -w apps/desktop",
    "tauri": "npm run tauri -w apps/desktop --",
    "version:check": "node scripts/version.mjs check",
    "version:next": "node scripts/version.mjs next",
    "version:bump": "node scripts/version.mjs bump",
    "test:scripts": "node --test scripts/version.test.mjs"
  }
}
