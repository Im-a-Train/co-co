{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Local app UI only (window 'main'). The remote 'ecamp-login' and 'midata-login' windows intentionally get NO capability and therefore no IPC access. The app commands are declared in an app ACL manifest (build.rs), so they are only callable with these grants.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-discover-instance",
    "allow-open-login-window",
    "allow-password-login",
    "allow-session-status",
    "allow-refresh-session",
    "allow-api-get",
    "allow-logout",
    "allow-api-post-comment",
    "allow-api-patch-comment",
    "allow-open-ecamp-url",
    "allow-pick-files",
    "allow-pick-folder",
    "allow-read-document",
    "allow-list-folder",
    "allow-watch-folder",
    "allow-unwatch-folder",
    "allow-save-text-file",
    "allow-open-text-file",
    "allow-ai-set-key",
    "allow-ai-has-key",
    "allow-ai-clear-key",
    "allow-ai-complete",
    "allow-midata-status",
    "allow-midata-open-login",
    "allow-midata-set-token",
    "allow-midata-logout",
    "allow-midata-find-events",
    "allow-midata-fetch-aggregate",
    "allow-midata-probe",
    "allow-midata-find-self",
    "allow-nds-status",
    "allow-nds-open-login",
    "allow-nds-logout",
    "allow-nds-find-camps",
    "allow-nds-fetch-aggregate",
    "allow-nds-probe",
    "allow-persons-load-midata",
    "allow-persons-load-nds",
    "allow-persons-clear",
    "allow-unlock-data-store",
    "allow-lock-data-store"
  ]
}
